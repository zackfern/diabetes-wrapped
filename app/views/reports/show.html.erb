<% uncontained_layout! %>

<div class="report">
  <header class="<%= 'cgm-only' unless @report.include_insulin? %>">
    Your <%= @report.year %> <%= link_to "diabetes wrapped", :root %>:
  </header>

  <% if @report.include_insulin? %>
    <div class="big-stat">
      You used a total of
      <strong class="grand-total">
        <%= number_to_delimited @report.total_insulin.round %>
        units
      </strong>
      of insulin.
    </div>

    <div class="container halves">
      <div class="big-number">
        <p class="number"><%= number_to_delimited @report.total_basal.round %></p>
        <p class="label">units of basal insulin</p>
      </div>

      <div class="big-number">
        <p class="number"><%= number_to_delimited @report.total_bolus.round %></p>
        <p class="label">units for boluses</p>
      </div>
    </div>

    <div class="container">
      <div class="vial-estimate">
        <div class="vials" style="--number: <%= @report.vial_estimate %>;">
          <span class="highlight">
            That's around <strong><%= pluralize @report.vial_estimate, 'vial' %></strong>
          </span>
        </div>
      </div>

      <div class="stat icon-left">
        <div class="icon material-symbols-outlined grey">calculate</div>
        <div>
          You bolused
          <strong>
            <%= number_to_delimited @report.bolus_count %>
          </strong>
          times.

          <p class="subtext">
            Or roughly <%= pluralize @report.boluses_per_day, "time" %> per day.
          </p>
        </div>
      </div>
    </div>
  <% end %>

  <section class="cgm <%= 'cgm-only' unless @report.include_insulin? %>">
    <div class="big-stat">
      Your average time in range was
      <strong class="grand-total">
        <%= @report.in_range_percentage %>%
      </strong>
    </div>

    <div class="container">
      <div class="stat icon-left">
        <div class="icon material-symbols-outlined">sensors</div>
        <div>
          You've had
          <strong>
            <%= number_to_delimited @report.total_readings %>
          </strong>
          CGM readings this year.
        </div>
      </div>

      <div class="stat icon-right">
        <% if @report.days_in_range > 0 %>
          <div>
            You spent
            <strong><%= pluralize @report.days_in_range, 'day' %></strong>
            100% in range!
          </div>
          <div class="icon material-symbols-outlined gold">trophy</div>
        <% else %>
          You didn't have any days 100% in range.
        <% end %>
      </div>

      <div class="stat icon-left bedtime">
        <div class="icon material-symbols-outlined">bedtime</div>
        <div>
          You were probably woken up
          <strong><%= pluralize @report.wake_ups, 'nights' %></strong>
          with low blood sugar.

          <p class="subtext">
            Or roughly once every <%= pluralize @report.wake_up_frequency, "night" %>.
          </p>
        </div>
      </div>

      <div class="stat icon-left">
        <div class="icon material-symbols-outlined">trending_up</div>
        <div>
          Your highest blood glucose was
          <%= bold_bg_with_unit(@highest_bg[:value], false) %>
          <p class="subtext">
            <% if @highest_bg[:instances] == 1 %>
              On <%= @highest_bg[:timestamp].in_time_zone(@report.user.timezone).to_fs(:date_with_time) %>
            <% elsif @highest_bg[:instances] <= 5 %>
              On <%= @highest_bg[:instances] %> different occasions.
            <% else %>
              <%= @highest_bg[:instances] %> different times!
            <% end %>
          </p>
        </div>
      </div>

      <div class="stat icon-right text-right">
        <div>
          And your lowest was
          <%= bold_bg_with_unit(@lowest_bg[:value], false) %>
          <p class="subtext">
            <% if @lowest_bg[:instances] == 1 %>
              <%= @lowest_bg[:timestamp].in_time_zone(@report.user.timezone).to_fs(:date_with_time) %>
            <% elsif @lowest_bg[:instances] <= 5 %>
              On <%= @lowest_bg[:instances] %> different occasions.
            <% else %>
              <%= @lowest_bg[:instances] %> different times!
            <% end %>
          </p>
        </div>
        <div class="icon material-symbols-outlined animate-jiggle">trending_down</div>
      </div>
    </div>
  </section>

  <section class="big-container">
    <h2>Monthly breakdown:</h2>

    <div class="months">
      <% @months.each do |month| %>
        <div class="month">
          <div class="name">
            <%= Date::MONTHNAMES[month.month] %>
          </div>

          <div class="halves">
            <% if @report.include_insulin? %>
              <div class="grid">
                <div class="label">Total basal:</div>
                <div class="number">
                  <%= rounded_number_delimited month.total_basal %><span class="unit small">u</span>
                </div>

                <div class="label">Total bolus:</div>
                <div class="number">
                  <%= rounded_number_delimited month.total_bolus %><span class="unit small">u</span>
                </div>

                <div class="label">Total insulin:</div>
                <div class="number">
                  <%= rounded_number_delimited month.total_insulin %><span class="unit small">u</span>
                </div>

                <div class="label">Biggest bolus:</div>
                <div class="number">
                  <%= rounded_number_delimited month.biggest_bolus %><span class="unit small">u</span>
                </div>
              </div>
            <% end %>

            <div class="grid">
              <div class="label">Highest BG:</div>
              <div class="number"><%= bg_with_unit(month.highest_bg) %></div>

              <div class="label">Lowest BG:</div>
              <div class="number"><%= bg_with_unit(month.lowest_bg) %></div>

              <div class="label">Days in range:</div>
              <div class="number"><%= month.days_in_range %></div>

              <div class="label">Wake ups:</div>
              <div class="number"><%= month.wake_ups %></div>
            </div>
          </div>
        </div>
      <% end %>
      <% if @report.incomplete? %>
        <div class="month incomplete">
          <div>
            <strong>The year isn't over yet!</strong>
            <% if viewer_is_owner? %>
              <p>Come back in January to re-run the report and see your complete stats.</p>
            <% else %>
              <p>This report is incomplete because it was generated before the end of the year.</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>

<footer class="big-container report">
  <% if viewer_is_owner? %>
    <section class="tools">
      <%= link_to report_download_path(format: :csv) do %>
        <span class="material-symbols-outlined">download_2</span>
        Download CSV
      <% end %>

      <% if @report.can_be_rerun? %>
        <%= link_to rerun_report_path, data: { turbo_method: :put } do %>
          <span class="material-symbols-outlined">refresh</span>
          Re-run Report
        <% end %>
      <% end %>
    </section>
  <% end %>

  <section class="disclaimer">
    <p>
      This report is meant for fun and to give a general idea of your life as a diabetic.
    </p>

    <p>
      Some of the information, specifically basal insulin calculation, may be inaccurate
      due to the complexity of calculations and variety of inputs.
      <%= link_to "Read about how the stats are calculated.", "https://github.com/zackfern/diabetes-wrapped#how-stats-are-calculated", target: "_blank" %>
    </p>

    <% if viewer_is_owner? %>
      <p>
        Please refer to your Nightscout instance itself for the most accurate statistics.
      </p>
    <% end %>
  </section>

  <section class="trackr-link">
    <% trackr_utm = "?utm_source=diabetes-wrapped&utm_campaign=#{@report.year}&utm_content=report" %>
    <% trackr_link = "https://trackr.health/#{trackr_utm}"  %>
    <h3>Want to do even more with your data?</h3>
    <p>
      <%= link_to "Trackr.health", trackr_link, target: "_blank" %>
      helps you <mark>track your meals, blood glucose, and activity.</mark>
      Connect your Nightscout instance, fitness device, and log your meals and activity
      to get a complete picture of your blood glucose and everything that influences it.
    </p>
    <div class="links">
      <%= link_to "Learn more", trackr_link, target: "_blank", class: "cta-button" %>
      <%= link_to "Join the beta waitlist", "https://trackr.health/waitlist#{trackr_utm}", target: "_blank", class: "cta-button" %>
    </div>
  </section>
</footer>
