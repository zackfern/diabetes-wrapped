<% if @user.errors.present? %>
  <div class="errors">
    An error ocurred:
    <ul>
      <% @user.errors.full_messages.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_for @user, data: { controller: "signup-form" } do |f| %>
  <div class="row">
    <%= f.label :email %>
    <%= f.email_field :email, placeholder: "tired-diabetic@example.com" %>
    <p class="description">
      We'll email you a link to manage your access your report and manage your data.
    </p>
  </div>

  <div class="row">
    <%= f.label :nightscout_host %>
    <%= f.text_field :nightscout_host, placeholder: "https://my-nightscout.example.com" %>
    <p class="description">
      The URL you use to connect to your Nightscout server.
      Include HTTP or HTTPS.
    </p>
  </div>

  <div class="row">
    <%= f.label :nightscout_token %>
    <%= f.password_field :nightscout_token, placeholder: "readonly-t0k3n" %>
    <p class="description">
      This allows us to query your data. We recommend using a unique,
      read-only key.
    </p>
  </div>

  <div class="row">
    <%= f.label :timezone %>
    <%= f.select :timezone, timezone_options_for_select(@user.timezone), {}, data: { signup_form_target: "tz" } %>
  </div>

  <div class="row">
    <%= f.label :unit %>
    <%= f.select :unit, User::UNITS, {}, data: { action: "signup-form#change_unit" } %>
    <p class="description">
      Which unit do you want to see your report in?
    </p>
  </div>

  <div class="row halves">
    <div class="column">
      <%= f.label :range_min, "Range minimum" %>
      <%= f.number_field :range_min, data: { signup_form_target: "rangeMin" } %>
    </div>

    <div class="column">
      <%= f.label :range_max, "Range maximum" %>
      <%= f.number_field :range_max, data: { signup_form_target: "rangeMax" } %>
    </div>

    <p class="description">
      Set the minimum and maximum values for what you consider to be "in range."
    </p>
  </div>

  <%= f.submit "Continue" %>
<% end %>
